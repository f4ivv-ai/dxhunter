# DX Hunter — configuration Maison / FLEX-6600M
# Ce fichier doit être copié dans ~/.config/dxhunter/maison-flex-6600m.env
# et protégé avec chmod 600. Ne placez jamais TOKEN, mot de passe, clé VPN
# ou adresse d'administration ARCO dans ce fichier.

STATION_NAME="Maison"
RADIO_MODEL="FLEX-6600M"

# Adresse LOCALE du FLEX-6600M. Remplacer CHANGE_ME avant installation.
FLEX_IP="CHANGE_ME"
FLEX_PORT="4992"
SLICE_ID="0"

# URL de DX Hunter déjà utilisée par le bridge. Ne la modifiez que si nécessaire.
SERVER_URL="https://dxclusterf4ivv.manus.space"

# Sécurité :
# - monitor bloque toutes les commandes radio.
# - receive autorise uniquement QSY et réglages RX (DSP, filtres, gain, EQ, spots).
#   TUNE, MOX, puissance, antennes et toute émission restent bloqués.
# - operate n'est pas requis pour la phase Maison actuelle. MOX/TUNE exigeraient
#   aussi ALLOW_TX_CONTROL=true après une validation matérielle explicite.
OPERATION_MODE="monitor"
ALLOW_TX_CONTROL="false"

# Déclaration de l'audio réellement choisi dans SmartSDR for Mac. Ce bridge ne
# modifie pas CoreAudio : il remonte le profil à DX Hunter pour l'affichage et la
# vérification d'exploitation. Laisser AUDIO_LISTEN_ONLY=true pendant les tests.
# Valeurs suggérées de profil : micro-gamer-casque, micro-gamer-haut-parleurs,
# dax-reception-numerique. Les noms de périphérique doivent être identiques à
# ceux visibles dans Réglages Système > Son et dans SmartSDR for Mac.
AUDIO_PROFILE="unconfigured"
AUDIO_INPUT_DEVICE=""
AUDIO_OUTPUT_DEVICE=""
AUDIO_DAX_ENABLED="false"
AUDIO_LISTEN_ONLY="true"

# Antenna Genius reste désactivé dans cette première étape. ARCO sera raccordé
# par son agent local dédié, sans publier son interface sur Internet.
AG_ENABLED="false"
AG_HOST=""
AG_PORT="9007"
