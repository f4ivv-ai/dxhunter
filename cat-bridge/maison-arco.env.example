# DX Hunter — configuration Maison / microHAM ARCO
# Copier vers ~/.config/dxhunter/maison-arco.env, puis chmod 600 sur ce fichier.
# Ne jamais mettre une adresse publique du pupitre, un mot de passe ou un token ici.

STATION_NAME="Maison"
CONTROLLER_NAME="microHAM ARCO"
SERVER_URL="https://dxclusterf4ivv.manus.space"

# URL de l'adaptateur ARCO en boucle locale sur le MacBook Pro seulement.
# L'adaptateur existant doit fournir l'API tRPC rotator.getState, rotator.goTo et rotator.stop.
# Le bridge refuse toute autre adresse afin de ne pas exposer le contrôleur ARCO.
ARCO_ADAPTER_URL="CHANGE_ME"

# Sûreté : lecture seule par défaut. Aucun mouvement n'est transmis.
OPERATION_MODE="monitor"
ALLOW_ARCO_MOTION="false"
