# ── À copier en .env sur le serveur, puis remplir. Ne jamais publier ce fichier rempli. ──

# Nom de domaine pointant vers le VPS (enregistrement DNS A)
DOMAIN=dxhunter.exemple.fr

# Connexion administrateur (au moins 12 caractères)
ADMIN_PASSWORD=
ADMIN_NAME=F4IVV

# Secret de signature des sessions (au moins 32 caractères) — générer avec : openssl rand -hex 32
JWT_SECRET=

# Base MySQL (utilisée par docker-compose)
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Jetons des bridges station (au moins 24 caractères chacun, différents) — openssl rand -hex 24
CAT_BRIDGE_TOKEN=
CONTEST_TOKEN=

# QRZ.com (recherche d'indicatifs)
QRZ_USERNAME=
QRZ_PASSWORD=

# Application rotor (laisser vide si non utilisée), ex. https://rotor.exemple.fr/api/trpc
ROTOR_API_URL=

# Captures planifiées intégrées (FT8 /15 min, calibration 12:00 UTC)
SCHEDULER_ENABLED=true
